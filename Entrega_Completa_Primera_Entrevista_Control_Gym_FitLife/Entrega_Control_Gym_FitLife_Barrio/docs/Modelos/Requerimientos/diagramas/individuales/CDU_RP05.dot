digraph G {
graph [rankdir=LR,bgcolor="white",pad="0.23",nodesep=".38",ranksep=".8",splines=polyline,fontname="Arial",fontsize=17,label="RP-05 · COMPROBANTE DIGITAL",labelloc=t,fontcolor="#153956"];
