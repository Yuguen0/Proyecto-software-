}
recep -> conf [dir=none];
recep -> com [dir=none];
recep -> env [dir=none];
recep -> imp [dir=none];
cliente -> env [dir=none];
msg -> env [dir=none];
com -> conf [style=dashed,label="<<include>>",fontsize=9,color="#168F81"];
env -> com [style=dashed,label="<<include>>",fontsize=9,color="#168F81"];
